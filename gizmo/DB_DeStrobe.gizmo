Group {
 name DB_DeStrobe
 onCreate "n = nuke.thisNode()\nh_knobs = n.knobs()\ntool_version = n\['version'].value()\nautolabel_string = \"nuke.thisNode().name() + ' v' + nuke.thisNode()\['version'].value() + '\\\\n(' + nuke.thisNode()\['retime_engine'].value() + ')' + ('\\\\n' + nuke.thisNode()\['label'].value() if nuke.thisNode()\['label'].value() else '' )\"\n\nn\['autolabel'].setValue(autolabel_string)\nn\['credits'].setValue(f\"<font size=2 color=#C86A4A><b>DB_DeStrobe \{tool_version\} </b></font><font size=2>by Dmitry Baramov</a></font>\")\n\nn\['lookup_curve'].clearFlag(0x0000000000000002)\nn\['smooth_strength'].setFlag(0x0000000000000002)\nn\['smooth_strength'].setRange(1,50)\nn\['smooth_strength'].setDefaultValue(\[10])\nn\['transition_ratio'].setDefaultValue(\[0.1])\n\nh_knobs\['oflowVectorDetailLocal'].setVisible(True)\nh_knobs\['oflowSmoothnessLocal'].setVisible(True)\nh_knobs\['oflowResampleType'].setVisible(True)\nh_knobs\['kronosVectorDetailReg'].setVisible(False)\nh_knobs\['kronosStrengthReg'].setVisible(False)\nh_knobs\['kronosResampleType'].setVisible(False)"
 knobChanged "n = nuke.thisNode()\nk = nuke.thisKnob()\n\nif k and k.name() == 'retime_engine':\n    engine = int(k.getValue())\n    h_knobs = n.knobs()\n\n    start_ops = 'n = nuke.thisNode()\\nh_knobs = n.knobs()'\n\n    slider_settings = \"n\['lookup_curve'].clearFlag(0x0000000000000002)\\nn\['smooth_strength'].setFlag(0x0000000000000002)\\nn\['smooth_strength'].setRange(1,50)\\nn\['smooth_strength'].setDefaultValue(\[10])\\nn\['transition_ratio'].setDefaultValue(\[0.1])\"\n\n    def toggle_engine_knobs(oflow):\n        h_knobs\['oflowVectorDetailLocal'].setVisible(oflow)\n        h_knobs\['oflowSmoothnessLocal'].setVisible(oflow)\n        h_knobs\['oflowResampleType'].setVisible(oflow)\n        h_knobs\['kronosVectorDetailReg'].setVisible(not oflow)\n        h_knobs\['kronosStrengthReg'].setVisible(not oflow)\n        h_knobs\['kronosResampleType'].setVisible(not oflow)\n\n        return f\"h_knobs\['oflowVectorDetailLocal'].setVisible(\{oflow\})\\nh_knobs\['oflowSmoothnessLocal'].setVisible(\{oflow\})\\nh_knobs\['oflowResampleType'].setVisible(\{oflow\})\\nh_knobs\['kronosVectorDetailReg'].setVisible(\{not oflow\})\\nh_knobs\['kronosStrengthReg'].setVisible(\{not oflow\})\\nh_knobs\['kronosResampleType'].setVisible(\{not oflow\})\".strip()\n\n    if engine == 0:\n        engine_knob_pos = toggle_engine_knobs(oflow=True)\n            \n    elif engine == 1:\n        engine_knob_pos = toggle_engine_knobs(oflow=False)\n\n    n\['onCreate'].setValue(f'\{start_ops\}\\n\{slider_settings\}\\n\{engine_knob_pos\}')"
 autolabel "nuke.thisNode().name() + ' v' + nuke.thisNode()\['version'].value() + '\\n(' + nuke.thisNode()\['retime_engine'].value() + ')' + ('\\n' + nuke.thisNode()\['label'].value() if nuke.thisNode()\['label'].value() else '' )"
 tile_color 0x6500e5ff
 addUserKnob {20 destrobe l DeStrobe}
 addUserKnob {26 smotthing l <b>Smoothing</b>}
 addUserKnob {3 smooth_strength l Strength R 1 50}
 addUserKnob {7 transition_ratio l "Transition Ratio" R 0.01 0.5}
 addUserKnob {26 space1 l "" +STARTLINE T " "}
 addUserKnob {22 calculate l <b>CALCULATE</b> +STARTLINE}
 addUserKnob {26 space2 l "" +STARTLINE T " "}
 addUserKnob {26 retime l <b>Retime</b>}
 addUserKnob {4 retime_engine l Engine M {OFlow Kronos "" "" ""}}
 addUserKnob {41 oflowVectorDetailLocal l "Vector Detail" T OFlow.vectorDetailLocal}
 addUserKnob {41 kronosVectorDetailReg l "Vector Detail" +HIDDEN T Kronos.vectorDetailReg}
 addUserKnob {41 oflowSmoothnessLocal l Smoothness T OFlow.smoothnessLocal}
 addUserKnob {41 kronosStrengthReg l Strength +HIDDEN T Kronos.strengthReg}
 addUserKnob {41 oflowResampleType l Filter T OFlow.resampleType}
 addUserKnob {41 kronosResampleType l Filter +HIDDEN T Kronos.resampleType}
 addUserKnob {26 space3 l "" +STARTLINE T " "}
 addUserKnob {26 info l <b>Info</b>}
 addUserKnob {26 info_text l " " T "<font size=3>Input Range: </font><br>\n<font size=3>Smooth Range: </font><br><br>\n<font size=3 color=yellow><b>WARNING: </b></font>"}
 addUserKnob {26 space4 l "" +STARTLINE T " "}
 addUserKnob {26 ""}
 addUserKnob {26 credits l "" +STARTLINE T "<font size=2 color=#C86A4A><b>DB_DeStrobe 1.0 </b></font><font size=2>by Dmitry Baramov</a></font>"}
 addUserKnob {26 space5 l "" +STARTLINE T " "}
 addUserKnob {12 original_curve +INVISIBLE}
 addUserKnob {12 smoothed_curve +INVISIBLE}
 addUserKnob {7 lookup_curve +INVISIBLE}
 lookup_curve {{frame}}
 addUserKnob {1 version +INVISIBLE}
 version 1.0
}
 Input {
  inputs 0
  name image
  xpos -140
  ypos -334
 }
 Dot {
  name Dot1
  xpos -106
  ypos -281
 }
set N70021c00 [stack 0]
 Kronos {
  retimedChannels all
  timing2 Frame
  timingFrame2 {{parent.lookup_curve}}
  motionEstimation Regularized
  name Kronos
  xpos -40
  ypos -238
  disable {{"Switch.which != 1"}}
 }
push $N70021c00
 OFlow2 {
  timing2 Frame
  timingFrame2 {{parent.lookup_curve}}
  name OFlow
  xpos -240
  ypos -234
  disable {{"Switch.which != 0"}}
 }
 Switch {
  inputs 2
  which {{parent.retime_engine}}
  name Switch
  xpos -140
  ypos -184
 }
 Output {
  name Output1
  xpos -140
  ypos -134
 }
 Input {
  inputs 0
  name tracker
  xpos 160
  ypos -334
  number 1
 }
 NoOp {
  name NoOp
  xpos 160
  ypos -234
 }
end_group